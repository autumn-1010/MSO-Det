{
  "schema_version": 1,
  "paper_settings": {
    "epochs": 72,
    "endpoint_epoch": 71,
    "stage2_start_epoch": 32,
    "seed": 42,
    "input_size": [640, 640],
    "aswb_alpha_range": [0.05, 0.2],
    "aswb_speed_range": [0.8, 1.5],
    "aswb_reduction": 8,
    "msia_target_size": 40,
    "msia_threshold": 6.0,
    "msia_residual_weight": 0.5,
    "ugdr_beta_start": 1.0,
    "ugdr_beta_end": 0.1,
    "ugdr_schedule_epochs": 160,
    "ugdr_reg_max": 32
  },
  "known_gwhd_test_domains": [
    "ARC_1",
    "CIMMYT_1",
    "CIMMYT_2",
    "CIMMYT_3",
    "Terraref_1",
    "Terraref_2",
    "NAU_2",
    "NAU_3",
    "Ukyoto_1",
    "UQ_7",
    "UQ_8",
    "UQ_9",
    "UQ_10",
    "UQ_11",
    "KSU_1",
    "KSU_2",
    "KSU_3",
    "KSU_4"
  ],
  "targeted_comparisons": {
    "density": ["Baseline", "ASWB"],
    "domain": ["Baseline", "MSIA"],
    "stage": ["Baseline", "Ours"],
    "occlusion": ["Baseline", "UGDR"]
  },
  "variants": {
    "Baseline": {
      "config": "configs/yaml/dfine.yml",
      "log_dir": "Baseline",
      "expected_modules": {"ASWB": false, "MSIA": false, "UGDR": false},
      "output_dir_candidates": ["outputs/dfine_s"]
    },
    "ASWB": {
      "config": "configs/yaml/my1_wave.yml",
      "log_dir": "ASWB",
      "expected_modules": {"ASWB": true, "MSIA": false, "UGDR": false},
      "legacy_model_configs": ["configs/cfg/my1_wave_v2_s.yaml"],
      "output_dir_candidates": ["outputs/my1_wave_v2_s", "outputs/dfine-s-wave"]
    },
    "MSIA": {
      "config": "configs/yaml/my1_hypergraph.yml",
      "log_dir": "MSIA",
      "expected_modules": {"ASWB": false, "MSIA": true, "UGDR": false},
      "legacy_model_configs": ["configs/cfg/dfine-s-hyper.yaml"],
      "output_dir_candidates": ["outputs/dfine-s-hypergraph"]
    },
    "UGDR": {
      "config": "configs/yaml/my1_ugdr.yml",
      "log_dir": "UGDR",
      "expected_modules": {"ASWB": false, "MSIA": false, "UGDR": true},
      "output_dir_candidates": ["outputs/my1_ugdr_s"]
    },
    "ASWB+MSIA": {
      "config": "configs/yaml/my1_hypergraph-wave.yml",
      "log_dir": "ASWB+MSIA",
      "expected_modules": {"ASWB": true, "MSIA": true, "UGDR": false},
      "output_dir_candidates": ["outputs/dfine-s-hypergraph-wave"]
    },
    "ASWB+UGDR": {
      "config": "configs/yaml/my1_ugdr-wave.yml",
      "log_dir": "ASWB+UGDR",
      "expected_modules": {"ASWB": true, "MSIA": false, "UGDR": true},
      "output_dir_candidates": ["outputs/my1-s-ugdr-wave"]
    },
    "MSIA+UGDR": {
      "config": "configs/yaml/my1_ugdr-hypergraph.yml",
      "log_dir": "MSIA+UGDR",
      "expected_modules": {"ASWB": false, "MSIA": true, "UGDR": true},
      "output_dir_candidates": ["outputs/my1-s-ugdr-hypergraph"]
    },
    "Ours": {
      "config": "configs/yaml/my1_all.yml",
      "log_dir": "Ours",
      "expected_modules": {"ASWB": true, "MSIA": true, "UGDR": true},
      "output_dir_candidates": ["outputs/my1_all"]
    }
  }
}
